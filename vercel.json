{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/liberar-estoque-pendente",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/admin.html",
      "destination": "/server.js"
    },
    {
      "source": "/search.html",
      "destination": "/server.js"
    },
    {
      "source": "/produto.html",
      "destination": "/server.js"
    },
    {
      "source": "/",
      "destination": "/server.js"
    },
    {
      "source": "/index.html",
      "destination": "/server.js"
    },
    {
      "source": "/favicon.svg",
      "destination": "/server.js"
    }
  ]
}
