{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/admin.html",
      "destination": "/server.js"
    },
    {
      "source": "/",
      "destination": "/server.js"
    },
    {
      "source": "/index.html",
      "destination": "/server.js"
    }
  ]
}
